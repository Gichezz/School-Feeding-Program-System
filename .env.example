# Settings for Docker Compose (docker-compose.yml). Copy to .env, which is never committed.

# Database password, used by the database and the API. Use letters and digits only (it is
# part of a connection URL). Generate a long random one, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=lishe
POSTGRES_DB=school_feeding

# Signs sign-in sessions; at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Load the demo school and demo accounts on the database's first start.
# Their passwords are published in database/seed.sql: local use only, never on a public server.
LOAD_DEMO_DATA=false

# Local: the port the app is served on (http://localhost:8080)
WEB_PORT=8080

# Public server only (docker-compose.prod.yml): the domain name pointing at this server
# DOMAIN=lishe.example.org
