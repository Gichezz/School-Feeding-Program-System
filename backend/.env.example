# Backend environment variables
# Copy this file to .env and adjust values for your machine.

PORT=5000
NODE_ENV=development

# PostgreSQL (authoritative central store)
# Prefer DATABASE_URL, or set the individual PG* variables.
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/school_feeding
PGHOST=localhost
PGPORT=5432
PGDATABASE=school_feeding
PGUSER=postgres
PGPASSWORD=your_password_here

# URL of the Flask forecasting service, and how long to wait for a forecast
FORECASTING_SERVICE_URL=http://localhost:5001
FORECASTING_TIMEOUT_MS=15000

# Browser origin allowed by CORS (set to the deployed frontend URL in production)
FRONTEND_URL=http://localhost:5173
# Maximum JSON request body size
JSON_BODY_LIMIT=100kb

# Session tokens: a long random secret (never commit a real one), and how long a sign-in lasts.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Passkeys for administrators (WebAuthn). WEBAUTHN_RP_ID is the domain passkeys belong to
# ("localhost" in development, the server's domain in production); passkeys made for one
# domain do not work on another. WEBAUTHN_ORIGINS lists the browser origins allowed to use
# them, comma-separated (defaults to FRONTEND_URL).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:5173
WEBAUTHN_RP_NAME=Lishe

# Authenticator app codes for administrators (#63). The secrets are encrypted with this key:
# 64 hex characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# Optional: when empty, a key is derived from JWT_SECRET. Changing the key in use means
# administrators set up their authenticator app again.
TOTP_ENCRYPTION_KEY=

# Record review (#62): the schools' time zone and school day. Records captured outside these
# hours, or kept on a device for longer than OFFLINE_FLAG_HOURS before syncing, are flagged
# for an administrator to check (never blocked).
SCHOOL_TIMEZONE=Africa/Nairobi
SCHOOL_DAY_START=06:00
SCHOOL_DAY_END=18:00
OFFLINE_FLAG_HOURS=72
