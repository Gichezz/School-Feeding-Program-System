# Backend environment variables
# Copy this file to .env and adjust values for your machine.

PORT=5000
NODE_ENV=development

# PostgreSQL (authoritative central store)
# Prefer DATABASE_URL, or set the individual PG* variables.
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/school_feeding
PGHOST=localhost
PGPORT=5432
PGDATABASE=school_feeding
PGUSER=postgres
PGPASSWORD=your_password_here

# Optional: URL of the Flask forecasting service (used in a later phase)
FORECASTING_SERVICE_URL=http://localhost:5000
